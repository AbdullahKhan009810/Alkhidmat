# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database (for Prisma migrations) ─────────────────────
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# ── AI: STT + Brain — Qwen (DashScope) ──
QWEN_API_KEY="your-qwen-api-key"
QWEN_BASE_URL="https://your-endpoint.maas.aliyuncs.com/compatible-mode/v1"
QWEN_EMBEDDING_MODEL="text-embedding-v4"
QWEN_CHAT_MODEL="qwen-plus"
QWEN_REALTIME_MODEL="qwen3-omni-flash-realtime"

# ── AI: TTS — Uplift AI (primary, native Urdu) ─
UPLIFTAI_API_KEY="your-upliftai-api-key"
UPLIFTAI_TTS_VOICE="broadband-support"
UPLIFTAI_TTS_FORMAT="MP3_22050_128"

# ── AI: TTS — ElevenLabs (English voice) ──
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"
ELEVENLABS_TTS_VOICE_EN="your-english-voice-id"
ELEVENLABS_TTS_VOICE="your-urdu-voice-id"
ELEVENLABS_PRONUNCIATION_DICT_ID="your-dict-id"

# ── RAG: local JSON knowledge base ──
KB_DATA_DIR="./data/kb"
KB_INDEX_FILE="./data/kb-index.json"
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# ── RAG: backup vector store — Upstash (optional) ──
UPSTASH_VECTOR_URL="https://your-index-vector.upstash.io"
UPSTASH_VECTOR_TOKEN="your-upstash-token"
